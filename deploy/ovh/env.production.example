# Copy to the repo root as .env.production on the OVH VM (never commit it).
#   cp deploy/ovh/env.production.example .env.production

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-output-of-python3-c-import-secrets-print-secrets.token_urlsafe-64

# Public URL Caddy serves. Use :80 until you have a domain, then:
#   SITE_ADDRESS=skills.yourdomain.com
#   ACME_EMAIL=you@yourdomain.com
SITE_ADDRESS=:80
ACME_EMAIL=

BACKEND_CORS_ORIGINS=http://YOUR_OVH_IP
VITE_API_BASE_URL=/api

POSTGRES_DB=skill_analyser
POSTGRES_USER=skill_analyser
POSTGRES_PASSWORD=replace-with-a-strong-password

NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-password

USE_CELERY=true
GRAPH_BACKEND=neo4j
VECTOR_BACKEND=pgvector
EMBEDDING_BACKEND=hash
LLM_BACKEND=template
INSTALL_AI_EXTRAS=false

FILE_ENCRYPTION_ENABLED=false

FIRST_SUPERUSER_EMAIL=admin@skillanalyser.ai
FIRST_SUPERUSER_PASSWORD=change-me-after-first-login
FIRST_SUPERUSER_NAME=HR Administrator
