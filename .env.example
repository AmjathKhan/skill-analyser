# ---------------------------------------------------------------------------
# AI Skill Analyser - environment configuration
# Copy to .env and adjust before running docker compose / the backend locally.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="AI Skill Analyser"
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200
SESSION_IDLE_TIMEOUT_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skill_analyser
POSTGRES_USER=skill_analyser
POSTGRES_PASSWORD=skill_analyser
# Optional full override (takes precedence over the parts above)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# false => resume processing runs inline via FastAPI BackgroundTasks (no worker needed)
USE_CELERY=false

# --- File storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.txt
# Fernet key for at-rest encryption of resume files.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_ENABLED=false
FILE_ENCRYPTION_KEY=

# --- Skills knowledge base ---
SKILLS_CSV_PATH=./data/skills.csv
AUTO_IMPORT_SKILLS=true

# --- AI / NLP ---
# hash => zero-download deterministic embeddings (works offline, great for CI)
# sentence-transformers => real semantic embeddings (requires the AI extras)
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
SPACY_MODEL=en_core_web_sm
ENABLE_OCR=false
TESSERACT_CMD=

# --- Vector search: pgvector | faiss | numpy ---
VECTOR_BACKEND=numpy

# --- Graph backend: networkx | neo4j ---
GRAPH_BACKEND=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j

# --- LLM reasoning: template | openai ---
# `template` = offline deterministic explanations (default).
# `openai` = OpenAI-compatible chat API. Put the real key in `.env` (not here).
# Create a key: https://platform.openai.com/api-keys
# Official OpenAI: OPENAI_BASE_URL=https://api.openai.com/v1
# Ollama local:    OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama
LLM_BACKEND=template
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

# --- Matching weights (must sum to 1.0) ---
MATCH_WEIGHT_SKILL=0.4
MATCH_WEIGHT_SEMANTIC=0.2
MATCH_WEIGHT_EXPERIENCE=0.2
MATCH_WEIGHT_CERTIFICATION=0.1
MATCH_WEIGHT_PROJECT=0.1

# --- Bootstrap admin (created by `python -m scripts.seed`) ---
FIRST_SUPERUSER_EMAIL=admin@skillanalyser.ai
FIRST_SUPERUSER_PASSWORD=Admin@12345
FIRST_SUPERUSER_NAME="HR Administrator"

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME="AI Skill Analyser"
